{
  "info": {
    "name": "Fuel Route Planner",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "Long trip (NY -> LA), GET",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/route/?start=New York, NY&finish=Los Angeles, CA",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            }
          ]
        }
      }
    },
    {
      "name": "Long trip, POST JSON",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Miami, FL\",\n  \"finish\": \"Seattle, WA\"\n}"
        }
      }
    },
    {
      "name": "Coordinates input",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"41.8781,-87.6298\",\n  \"finish\": {\n    \"lat\": 39.7392,\n    \"lon\": -104.9903\n  }\n}"
        }
      }
    },
    {
      "name": "Short trip (no stop needed)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/route/?start=Chicago, IL&finish=Indianapolis, IN",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Chicago, IL"
            },
            {
              "key": "finish",
              "value": "Indianapolis, IN"
            }
          ]
        }
      }
    },
    {
      "name": "Start with 10% tank",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/route/?start=Chicago, IL&finish=Indianapolis, IN&starting_fuel_percent=10",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Chicago, IL"
            },
            {
              "key": "finish",
              "value": "Indianapolis, IN"
            },
            {
              "key": "starting_fuel_percent",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "Error: outside USA",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/route/?start=Chicago, IL&finish=51.5,-0.12",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Chicago, IL"
            },
            {
              "key": "finish",
              "value": "51.5,-0.12"
            }
          ]
        }
      }
    },
    {
      "name": "Error: missing finish",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/route/?start=Chicago, IL",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Chicago, IL"
            }
          ]
        }
      }
    }
  ]
}